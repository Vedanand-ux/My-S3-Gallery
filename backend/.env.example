# AWS credentials — leave blank if running on EC2/Elastic Beanstalk with an IAM role attached
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# The S3 bucket that stores gallery images
S3_BUCKET_NAME=your-gallery-bucket-name

# How long a presigned URL stays valid, in seconds
PRESIGN_EXPIRY_SECONDS=300

# Port the API listens on
PORT=4000

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173
